# Pre-existing peer-dep conflict resolved across the project:
#   openapi-typescript@7.13.0 declares peer typescript@^5.x,
#   but the project pins typescript@~6.0.2 (Vite 8 ships TS 6).
# The Dockerfile already uses --legacy-peer-deps; persisting it here keeps
# host-side npx/shadcn invocations consistent with the container baseline.
legacy-peer-deps=true
