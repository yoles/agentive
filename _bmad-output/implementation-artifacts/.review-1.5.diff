+"""Public API surface for :class:`FeatureFlag`. ALL DB access must go through this class."""
+
+from __future__ import annotations
+
+from uuid import UUID
+
+from sqlalchemy import select
+from sqlalchemy.dialects.postgresql import insert as pg_insert
+
+from agentive_backend.infra.db.models import FeatureFlag
+from agentive_backend.shared.repositories.base import BaseRepo
+
+
+class FeatureFlagRepo(BaseRepo):
+    """Read/write access to the ``feature_flags`` table.
+
+    Feature flags are global (no ``tenant_id``) — they gate whole-system
+    behaviors. The :meth:`with_tenant` machinery is still used for
+    consistency but ``tenant_id=None`` is the canonical call.
+    """
+
+    async def get(self, name: str, *, tenant_id: UUID | None = None) -> FeatureFlag | None:
+        async with self.with_tenant(tenant_id) as session:
+            return await session.get(FeatureFlag, name)
+
+    async def list_enabled(self, *, tenant_id: UUID | None = None) -> list[FeatureFlag]:
+        async with self.with_tenant(tenant_id) as session:
+            stmt = select(FeatureFlag).where(FeatureFlag.enabled.is_(True))
+            result = await session.execute(stmt)
+            return list(result.scalars().all())
+
+    async def set(
+        self,
+        *,
+        name: str,
+        enabled: bool,
+        rollout_percentage: int = 0,
+        description: str | None = None,
+        tenant_id: UUID | None = None,
+    ) -> None:
+        """Upsert a feature flag."""
+        async with self.with_tenant(tenant_id) as session:
+            values = {
+                "name": name,
+                "enabled": enabled,
+                "rollout_percentage": rollout_percentage,
+                "description": description,
+            }
+            stmt = pg_insert(FeatureFlag).values(**values)
+            stmt = stmt.on_conflict_do_update(
+                index_elements=[FeatureFlag.name],
+                set_={
+                    "enabled": enabled,
+                    "rollout_percentage": rollout_percentage,
+                    "description": description,
+                },
+            )
+            await session.execute(stmt)

