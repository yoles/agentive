new file mode 100644
--- /dev/null
+++ b/backend/tests/integration/repositories/test_isolation_audit.py
+"""Cross-tenant isolation — ``audit_events`` table.
+
+Sprint 0 status: ``AuditEventRepo.record()`` raises ``NotImplementedError``
+until Story 9.1 wires the ``agentive_audit_admin`` session factory. The
+isolation guarantee is enforced by Postgres RLS regardless — this test
+verifies the policy is in place using the BYPASSRLS seed role to plant
+data, then asserts the app role's view is filtered.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.exc import DBAPIError
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+pytestmark = pytest.mark.integration
+
+
+@pytest.mark.asyncio
+async def test_audit_events_filtered_by_rls_when_app_role_reads(
+    app_session_factory: async_sessionmaker[AsyncSession],
+    seed_session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    tenant_a, tenant_b = uuid4(), uuid4()
+    correlation_a, correlation_b = uuid4(), uuid4()
+
+    # Plant one audit row per tenant via the BYPASSRLS seed role.
+    async with seed_session_factory() as session:
+        await session.execute(
+            text(
+                "INSERT INTO audit_events "
+                "(actor, action, correlation_id, tenant_id) "
+                "VALUES ('actor-a', 'test.tenant.a', :cid, :tid)"
+            ),
+            {"cid": str(correlation_a), "tid": str(tenant_a)},
+        )
+        await session.execute(
+            text(
+                "INSERT INTO audit_events "
+                "(actor, action, correlation_id, tenant_id) "
+                "VALUES ('actor-b', 'test.tenant.b', :cid, :tid)"
+            ),
+            {"cid": str(correlation_b), "tid": str(tenant_b)},
+        )
+        await session.commit()
+
+    # The agentive_app role has no SELECT grant on audit_events (REVOKEd
+    # explicitly in the migration). Even with RLS bypassed by privilege,
+    # the GRANT layer blocks reads — surface as DBAPIError ``permission
+    # denied``. This validates the layered defense (RLS + role grants).
+    async with app_session_factory() as session:
+        with pytest.raises(DBAPIError):
+            await session.execute(text("SELECT COUNT(*) FROM audit_events"))

