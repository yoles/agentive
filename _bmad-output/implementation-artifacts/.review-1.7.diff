@@ -0,0 +1,104 @@
+"""Integration tests — audit event ``system.token.used`` — Story 1.7 (AC3).
+
+Uses ``httpx.AsyncClient`` + ``ASGITransport`` (same event loop as the test)
+so that ``asyncio.create_task`` background tasks complete before assertions.
+"""
+
+from __future__ import annotations
+
+import asyncio
+
+import httpx
+import pytest
+from fastapi import FastAPI
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker
+
+from agentive_backend.app.middleware import AuthTokenMiddleware, CorrelationIdMiddleware
+
+
+def _make_app(
+    token: str,
+    session_factory: async_sessionmaker[AsyncSession],
+) -> FastAPI:
+    app = FastAPI()
+    app.state.auth_token_hash = token
+    app.state.session_factory = session_factory
+
+    app.add_middleware(AuthTokenMiddleware)
+    app.add_middleware(CorrelationIdMiddleware)
+
+    @app.get("/api/v1/test")
+    async def _endpoint() -> dict[str, str]:
+        return {"ok": "true"}
+
+    return app
+
+
+@pytest.mark.asyncio
+async def test_valid_auth_publishes_token_used_event(
+    app_session_factory: async_sessionmaker[AsyncSession],
+    seed_session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Successful auth → outbox row with event_type=system.token.used."""
+    # Start with a clean slate so this test is independent of run order.
+    async with seed_session_factory() as session:
+        await session.execute(text("DELETE FROM outbox_events WHERE event_type = 'system.token.used'"))
+        await session.commit()
+
+    app = _make_app("change_me", app_session_factory)
+
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app),
+        base_url="http://testserver",
+    ) as client:
+        response = await client.get("/api/v1/test", headers={"Authorization": "Bearer change_me"})
+    assert response.status_code == 200
+
+    # Let the fire-and-forget task complete in the same event loop.
+    await asyncio.sleep(0.2)
+
+    async with app_session_factory() as session:
+        result = await session.execute(
+            text(
+                "SELECT event_type FROM outbox_events "
+                "WHERE event_type = 'system.token.used'"
+            )
+        )
+        rows = result.fetchall()
+
+    assert len(rows) >= 1, "Expected at least one system.token.used outbox row"
+
+
+@pytest.mark.asyncio
+async def test_invalid_auth_does_not_publish_event(
+    app_session_factory: async_sessionmaker[AsyncSession],
+    seed_session_factory: async_sessionmaker[AsyncSession],
+) -> None:
+    """Failed auth (401) → no system.token.used event published."""
+    # Start with a clean slate so this test is independent of run order.
+    async with seed_session_factory() as session:
+        await session.execute(text("DELETE FROM outbox_events WHERE event_type = 'system.token.used'"))
+        await session.commit()
+
+    app = _make_app("change_me", app_session_factory)
+
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app),
+        base_url="http://testserver",
+    ) as client:
+        response = await client.get("/api/v1/test", headers={"Authorization": "Bearer wrong-token"})
+    assert response.status_code == 401
+
+    await asyncio.sleep(0.1)
+
+    async with app_session_factory() as session:
+        result = await session.execute(
+            text(
+                "SELECT COUNT(*) FROM outbox_events "
+                "WHERE event_type = 'system.token.used'"
+            )
+        )
+        count = result.scalar()
+
+    assert count == 0, f"Expected 0 token.used events for failed auth, got {count}"
