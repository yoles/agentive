[importlinter]
root_package = agentive_backend
include_external_packages = False

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CANONICAL CONTRACT FILE FOR AGENTIVE BACKEND
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Invocation : `lint-imports --config .import-linter` (from repo root)
# OR       : `lint-imports --config ../.import-linter` (from backend/)
#
# This is the SINGLE SOURCE OF TRUTH for import boundary rules.
# `backend/pyproject.toml` references this file via `contract_config_file`
# so `lint-imports` invoked without `--config` inside backend/ picks it up.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Contract 1 — Features are isolated from each other
# No feature module may import from another feature module.
# Inter-feature communication goes ONLY through:
#   - agentive_backend.shared.event_bus (events)
#   - agentive_backend.shared.contracts (shared schemas)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[importlinter:contract:features-isolated]
name = Feature modules must not import from each other
type = independence
modules =
    agentive_backend.features.m1_company_architect
    agentive_backend.features.m2_agent_registry
    agentive_backend.features.m3_workflow_engine
    agentive_backend.features.m4_memory_manager
    agentive_backend.features.m5_tool_hub
    agentive_backend.features.m6_dashboard
    agentive_backend.features.m7_chat
    agentive_backend.features.m8_agent_configurator
    agentive_backend.features.m9_topology
    agentive_backend.features.m10_reporting
    agentive_backend.features.m11_scheduler
    agentive_backend.features.m12_trace

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Contract 2 — Layered architecture : app → features → shared → infra
# Higher layers may depend on lower layers, never the reverse.
#   `app` may import features, shared, infra.
#   `features` may import shared, infra (but not other features — see Contract 1).
#   `shared` may import infra (for concrete adapters) but not features.
#   `infra` may not import features or shared business logic.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[importlinter:contract:layered]
name = Layered architecture (app → features → shared → infra)
type = layers
layers =
    agentive_backend.app
    agentive_backend.features
    agentive_backend.shared
    agentive_backend.infra

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Contract 3 — Direct DB access forbidden outside of infra.db / shared.repositories
# No feature module may import sqlalchemy / psycopg directly.
# All DB access goes through `agentive_backend.shared.repositories`, which is
# the ONLY shared module permitted to talk to SQLAlchemy.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[importlinter:contract:no-direct-db-access-from-features]
name = Feature modules must not import sqlalchemy / psycopg directly
type = forbidden
source_modules =
    agentive_backend.features
forbidden_modules =
    sqlalchemy
    sqlalchemy.ext.asyncio
    sqlalchemy.orm
    asyncpg
    psycopg
    psycopg2
