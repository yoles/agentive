# Agentive — Template staging environment
#
# ⚠️  Ce fichier est un TEMPLATE (commité). Le `.env.staging` réel vit dans le
# GitHub Secret `STAGING_ENV_FILE` et est déposé sur le serveur par le workflow
# `deploy-staging.yml`. Ne jamais commiter un `.env.staging` avec de vrais secrets.
#
# Consommé par : docker-compose.staging.yml (via `--env-file .env.staging`)
# Traefik SSL (Let's Encrypt) + ACME_EMAIL sont gérés par l'infrastructure idem
# (repo séparé), PAS ici.

# ─── Routage Traefik ───
STAGING_HOST=staging.agentive.idem-agency.fr

# ─── Runtime ───
LOG_LEVEL=INFO

# ─── Postgres (3 rôles applicatifs + superuser) ───
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_AUDIT_ADMIN_PASSWORD=

# ─── Agentive secrets ───
# `AGENTIVE_API_TOKEN` : random 32 bytes base64 (`openssl rand -base64 32`)
# `AGENTIVE_ENCRYPTION_KEY` : Fernet key (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
AGENTIVE_API_TOKEN=
AGENTIVE_ENCRYPTION_KEY=

# ─── CORS ───
# JSON list parsée par Pydantic Settings. Doit correspondre au host Traefik.
AGENTIVE_CORS_ALLOW_ORIGINS=["https://staging.agentive.idem-agency.fr"]

# ─── LLM providers (optionnels en staging) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
